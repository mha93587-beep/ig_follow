# Mode: 'Creator' for standard flow (no blur overlays, normal requirement, no comment popup)
# Or 'PUBLIC' for growth mode (blurry overlays, 2-step requirement verification, 4s comment popup)
WEB_MODE=PUBLIC

# SearchApi.io API Key for Instagram Profile API
# Get your API key from https://www.searchapi.io
SEARCHAPI_API_KEY=your_searchapi_api_key_here

PORT=5000
HOST=0.0.0.0
